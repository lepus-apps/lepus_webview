#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <pthread.h>
#include <errno.h>

// Forward declarations for webview functions
typedef void* webview_t;
extern webview_t webview_create(int debug, void* window);
extern void webview_destroy(webview_t w);
extern void webview_run(webview_t w);
extern void webview_terminate(webview_t w);
extern void webview_dispatch(webview_t w, void (*f)(webview_t, void*), void* arg);
extern void webview_set_title(webview_t w, const char* title);
extern void webview_set_size(webview_t w, int width, int height, int hints);
extern void webview_navigate(webview_t w, const char* url);
extern void webview_init(webview_t w, const char* js);
extern void webview_eval(webview_t w, const char* js);
extern void webview_bind(webview_t w, const char* name, void (*f)(const char* seq, const char* req, void* arg), void* arg);
extern void webview_return(webview_t w, const char* seq, int status, const char* result);
extern void webview_set_html(webview_t w, const char* html);
extern const webview_t webview_get_window(webview_t w);
extern const webview_t webview_get_native_handle(webview_t w, int kind);

#define MOONBIT_FFI_EXPORT __attribute__((visibility("default")))

// Window states
typedef enum {
    WINDOW_STATE_CREATED = 0,
    WINDOW_STATE_RUNNING = 1,
    WINDOW_STATE_HIDDEN = 2,
    WINDOW_STATE_CLOSING = 3,
    WINDOW_STATE_CLOSED = 4
} window_state_t;

// Process types
typedef enum {
    PROCESS_TYPE_MAIN = 0,
    PROCESS_TYPE_CHILD = 1
} process_type_t;

// IPC message types
typedef enum {
    IPC_MESSAGE_TYPE_DATA = 0,
    IPC_MESSAGE_TYPE_COMMAND = 1,
    IPC_MESSAGE_TYPE_EVENT = 2,
    IPC_MESSAGE_TYPE_REQUEST = 3,
    IPC_MESSAGE_TYPE_RESPONSE = 4
} ipc_message_type_t;

// Window structure
typedef struct webview_window {
    int window_id;
    webview_t handle;
    process_type_t process_type;
    pid_t process_id;
    window_state_t state;
    char title[256];
    int width;
    int height;
    int visible;
    int is_child_process;
    int parent_window_id;
    struct webview_window* next;
    struct webview_window* prev;
} webview_window_t;

// IPC message structure
typedef struct {
    int source_window_id;
    int target_window_id;
    ipc_message_type_t message_type;
    char message_subtype[64];
    char message_data[1024];
    int data_length;
} ipc_message_t;

// Window manager structure
typedef struct {
    webview_window_t* head;
    webview_window_t* tail;
    int window_count;
    int next_window_id;
    pthread_mutex_t mutex;
    int ipc_socket;
    char ipc_socket_path[256];
    int ipc_server_running;
    pthread_t ipc_thread;
} window_manager_t;

// Global window manager
static window_manager_t g_window_manager = {
    .head = NULL,
    .tail = NULL,
    .window_count = 0,
    .next_window_id = 1,
    .mutex = PTHREAD_MUTEX_INITIALIZER,
    .ipc_socket = -1,
    .ipc_socket_path = "/tmp/moonbit_webview_ipc",
    .ipc_server_running = 0,
    .ipc_thread = 0
};

// IPC client structure for child processes
typedef struct {
    int socket_fd;
    int window_id;
    int connected;
    pthread_t listener_thread;
} ipc_client_t;

static ipc_client_t g_ipc_client = {
    .socket_fd = -1,
    .window_id = -1,
    .connected = 0,
    .listener_thread = 0
};

// Helper functions
static webview_window_t* find_window_by_id(int window_id) {
    webview_window_t* current = g_window_manager.head;
    while (current) {
        if (current->window_id == window_id) {
            return current;
        }
        current = current->next;
    }
    return NULL;
}

static webview_window_t* find_window_by_pid(pid_t pid) {
    webview_window_t* current = g_window_manager.head;
    while (current) {
        if (current->process_id == pid) {
            return current;
        }
        current = current->next;
    }
    return NULL;
}

static int generate_window_id() {
    pthread_mutex_lock(&g_window_manager.mutex);
    int id = g_window_manager.next_window_id++;
    pthread_mutex_unlock(&g_window_manager.mutex);
    return id;
}

static void add_window_to_manager(webview_window_t* window) {
    pthread_mutex_lock(&g_window_manager.mutex);
    window->next = NULL;
    window->prev = g_window_manager.tail;
    
    if (g_window_manager.tail) {
        g_window_manager.tail->next = window;
    } else {
        g_window_manager.head = window;
    }
    
    g_window_manager.tail = window;
    g_window_manager.window_count++;
    pthread_mutex_unlock(&g_window_manager.mutex);
}

static void remove_window_from_manager(webview_window_t* window) {
    pthread_mutex_lock(&g_window_manager.mutex);
    
    if (window->prev) {
        window->prev->next = window->next;
    } else {
        g_window_manager.head = window->next;
    }
    
    if (window->next) {
        window->next->prev = window->prev;
    } else {
        g_window_manager.tail = window->prev;
    }
    
    g_window_manager.window_count--;
    pthread_mutex_unlock(&g_window_manager.mutex);
}

// IPC helper functions
static int create_ipc_socket() {
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("socket creation failed");
        return -1;
    }
    
    struct sockaddr_un addr;
    memset(&addr, 0, sizeof(addr));
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, g_window_manager.ipc_socket_path, sizeof(addr.sun_path) - 1);
    
    unlink(g_window_manager.ipc_socket_path);
    
    if (bind(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("bind failed");
        close(sock);
        return -1;
    }
    
    if (listen(sock, 10) < 0) {
        perror("listen failed");
        close(sock);
        return -1;
    }
    
    g_window_manager.ipc_socket = sock;
    return sock;
}

static int connect_to_ipc_server() {
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("socket creation failed");
        return -1;
    }
    
    struct sockaddr_un addr;
    memset(&addr, 0, sizeof(addr));
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, g_window_manager.ipc_socket_path, sizeof(addr.sun_path) - 1);
    
    if (connect(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("connect failed");
        close(sock);
        return -1;
    }
    
    return sock;
}