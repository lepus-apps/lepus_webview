import {
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/async" @async,
}

supported_targets = "+native"

options(
  link: {
    "native": {
      // MacOS / Linux
      "cc-link-flags": "-Llib -lwebview -Wl,-rpath,lib",
      // Windows
      // "cc-link-flags": "lib/webview.lib",
    },
  },
  "native-stub": [ "stub.c" ],
  targets: {
    "binding.mbt": [ "native" ],
    "command.mbt": [ "native" ],
    "plugin.mbt": [ "native" ],
    "webview.mbt": [ "native" ],
  },
)
