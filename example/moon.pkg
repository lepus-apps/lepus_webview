import {
  "lepus-apps/webview",
}

supported_targets = "+native"

options(
  is_main: true,
  link: {
    "native": {
      // MacOS
      "cc-link-flags": "-Llib -lwebview -Wl,-rpath,lib",
      // Windows
      // "cc-link-flags": "lib/webview.lib",
      // Linux
      // "cc-link-flags": "-Llib -lwebview",
    },
  },
)
